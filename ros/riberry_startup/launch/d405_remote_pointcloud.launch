<launch>
  <node pkg="nodelet" type="nodelet" name="remote_pcl_manager" args="manager" output="screen"/>

  <node pkg="image_transport" type="republish" name="rgb_decompress" output="screen"
        args="compressed in:=/camera/color/image_raw raw out:=/camera/color/image_raw_decompressed" />

  <node pkg="image_transport" type="republish" name="depth_decompress" output="screen"
        args="compressedDepth in:=/camera/aligned_depth_to_color/image_raw raw out:=/camera/aligned_depth_to_color/image_raw_decompressed" />

  <node pkg="nodelet" type="nodelet" name="point_cloud_xyzrgb" args="load depth_image_proc/point_cloud_xyzrgb remote_pcl_manager" output="screen">

    <remap from="rgb/image_rect_color" to="/camera/color/image_raw_decompressed"/>
    <remap from="depth_registered/image_rect" to="/camera/aligned_depth_to_color/image_raw_decompressed"/>
    <remap from="rgb/camera_info" to="/camera/color/camera_info"/>

    <remap from="depth_registered/points" to="/camera/depth_registered/points_reconstructed"/>
  </node>

</launch>
